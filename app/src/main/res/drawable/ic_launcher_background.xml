<?xml version="1.0" encoding="utf-8"?>
<!--
  Climate Control icon — adaptive icon background
  Cool→warm horizontal gradient with soft glows under each symbol and a
  subtle dual-zone divider. Symbols live in ic_launcher_foreground.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Base cool→warm gradient ── -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="54"
                android:endX="108" android:endY="54">
                <item android:offset="0.0"  android:color="#123E5A"/>
                <item android:offset="0.4"  android:color="#0A1320"/>
                <item android:offset="0.6"  android:color="#1A0F0A"/>
                <item android:offset="1.0"  android:color="#48280F"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ── Cool glow (under snowflake) ── -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="38" android:centerY="54" android:gradientRadius="40"
                android:startColor="#4734D6F0" android:endColor="#0034D6F0"/>
        </aapt:attr>
    </path>

    <!-- ── Warm glow (under heat waves) ── -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="74" android:centerY="54" android:gradientRadius="38"
                android:startColor="#42FF9A3D" android:endColor="#00FF9A3D"/>
        </aapt:attr>
    </path>

</vector>
